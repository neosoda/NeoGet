{
  "name": "neoget",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:nowatch": "tauri dev --no-watch",
    "launch": "npm run build && tauri dev --no-watch",
    "tauri:build": "tauri build && node -e \"try { require('child_process').execSync('taskkill /F /IM NeoGet.exe', {stdio:'ignore'}); } catch(e){} require('fs').copyFileSync('C:/Users/NEO.NEO-PC/.cargo/target/neoget/release/neoget.exe', './NeoGet.exe')\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.424.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vite": "^8.2.1"
  }
}
